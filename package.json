{
  "name": "8bitdo-deck",
  "version": "0.3.0-alpha.4",
  "description": "A unified 8BitDo firmware companion for Steam Deck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit && tsc --noEmit -p desktop/tsconfig.json",
    "test:ui": "node --test tests/ui-smoke.mjs tests/firmware-selection.mjs",
    "watch": "rollup -c -w",
    "dev:desktop": "vite --config desktop/vite.config.ts",
    "build:desktop": "tsc --noEmit -p desktop/tsconfig.json && vite build --config desktop/vite.config.ts",
    "test:desktop": "playwright test --config desktop/playwright.config.ts",
    "tauri": "tauri"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trevor-scheer/8bitdo-deck.git"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.0",
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.6",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "5.1.20",
    "react": "19.3.1",
    "react-test-renderer": "19.3.1",
    "rollup": "4.53.3",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "@tauri-apps/api": "2.12.5",
    "react-dom": "19.3.1",
    "tslib": "2.8.1"
  }
}
