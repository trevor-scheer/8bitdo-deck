    "@types/react-router": "5.1.20",
    "react": "19.3.1",
    "react-test-renderer": "19.3.1",
    "rollup": "4.53.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.8.1"
